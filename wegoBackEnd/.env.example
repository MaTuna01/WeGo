# 서버 환경 변수 예시. 이 파일을 .env로 복사해서 값을 채움(.env는 gitignore, 커밋 금지)
# 로컬: IntelliJ EnvFile 플러그인으로 주입 / 배포: docker-compose env_file로 주입
# 선택 항목은 바꿀 때만 주석을 풀고 값을 채움. KEY= 처럼 빈 값으로 두면 기본값 대신 빈 문자열이 들어감

# 서버 포트(기본 8080)
# SERVER_PORT=8080

# 최소 지원 앱 버전(기본 1.0.0). 올리면 이보다 낮은 앱은 업데이트 안내로 막힘
# WEGO_MINIMUM_VERSION=1.0.0
