# 서버 환경 변수 예시. 이 파일을 .env로 복사해서 값을 채움(.env는 gitignore, 커밋 금지)
# 로컬: IntelliJ EnvFile 플러그인으로 주입 / 배포: docker-compose env_file로 주입
# 선택 항목은 바꿀 때만 주석을 풀고 값을 채움. KEY= 처럼 빈 값으로 두면 기본값 대신 빈 문자열이 들어감

# 서버 포트(기본 8080)
# SERVER_PORT=8080

# 서울 열린데이터광장 공공자전거 실시간 대여정보 API 인증키(필수, 없으면 GET /stations가 503)
SEOUL_OPEN_API_KEY=

# PostgreSQL(PostGIS). 배포에서는 db 컨테이너도 이 세 값으로 DB와 계정을 만듦(필수)
# 비밀번호는 길고 무작위로(예: openssl rand -base64 24). 처음 띄운 뒤 바꾸려면 DB 안에서도 바꿔야 함
POSTGRES_DB=wego
POSTGRES_USER=wego
POSTGRES_PASSWORD=

# DB 주소(기본 localhost:5432). 배포에서는 docker-compose가 DB_HOST=db로 지정
# DB_HOST=localhost
# DB_PORT=5432

# 최소 지원 앱 버전(기본 1.0.0). 올리면 이보다 낮은 앱은 업데이트 안내로 막힘
# WEGO_MINIMUM_VERSION=1.0.0
